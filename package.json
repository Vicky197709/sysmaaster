{
  "name": "sysmaster",
  "version": "1.0.0",
  "description": "SysMaster — console de monitoring et de contrôle total du PC",
  "homepage": "https://github.com/Vicky197709/sysmaaster",
  "main": "out/main/index.js",
  "author": "SysMaster",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "start": "electron-vite preview --noSandbox",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "mcp": "electron out/main/index.js --mcp --no-sandbox",
    "dist": "npm run build && electron-builder --linux deb AppImage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.0",
    "recharts": "^2.15.0",
    "systeminformation": "^5.22.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.local.sysmaster",
    "productName": "SysMaster",
    "directories": { "output": "dist" },
    "files": ["out/**/*", "package.json"],
    "linux": { "target": ["deb", "AppImage"], "category": "System", "maintainer": "SysMaster <local@localhost>" }
  }
}
